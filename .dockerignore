# Never let a secret into a layer. .env.local holds the API key.
.env
.env.*
!.env.example

node_modules
.git
.gitignore

# Generated at runtime; the container gets these from the mounted volume, not the image.
data/cache
data/index
data/trace
data/last-check.json
logs

# Not needed to run the service. Root docs are named explicitly rather than via `*.md`, so
# there is no way to misread the rule as also excluding data/snapshots/*.md.
tests
docs
CLAUDE.md
git.md
quick_start.md
quick_start_zh.md
.DS_Store
